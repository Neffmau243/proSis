    {"listen":"prerequest","script":{"type":"text/javascript","exec":["const cv = pm.collectionVariables;","if (!cv.get('runId')) {","  const stamp = Date.now().toString();","  const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0, 10);","  cv.set('runId', stamp);","  cv.set('runSuffix', stamp.slice(-8));","  cv.set('testDate', yesterday);","  cv.set('testDocumentNumber', String(Math.floor(10000000 + Math.random() * 90000000)));","  cv.set('testProfessionalPassword', '53918420');","  cv.set('testProfessionalPasswordAfterReset', '63041852');","  cv.set('testProfessionalPasswordAfterOwnChange', '28495016');","  cv.set('testUsername', 'pm.med.' + stamp.slice(-10));","}","const protectedNames = ['baseUrl', 'adminUsername', 'adminPassword', 'adminAccessToken', 'professionalAccessToken', 'runId', 'runSuffix', 'testDate', 'testDocumentNumber', 'testProfessionalPassword', 'testProfessionalPasswordAfterReset', 'testProfessionalPasswordAfterOwnChange', 'testUsername', 'documentTypeCode', 'sexCode', 'insuranceId', 'professionId', 'specialtyCode', 'attentionModeCode', 'riskGroupId', 'serviceCode', 'cie10Code', 'establishmentId', 'destinationEstablishmentId', 'ubigeoCode', 'ageGroupsPayload', 'professionalId', 'officeId', 'userId', 'patientId', 'responsibleId', 'documentAttentionId', 'cancelAttentionId'];","protectedNames.forEach(function (key) { const value = cv.get(key); if (value === undefined) { pm.variables.unset(key); } else { pm.variables.set(key, value); } });"]}},
